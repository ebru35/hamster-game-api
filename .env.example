# IMPORTANT: Replace PASSWORD with your actual Neon credentials
# Get your connection string from: https://console.neon.tech
# Click your project → Connection string → Copy the PostgreSQL URL
# Format should be: postgresql://neondb_owner:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Webhook Secret (optional)
# If set, all POST requests to /events must include X-Webhook-Secret header
# Leave empty to allow all requests
WEBHOOK_SECRET=
